--- a/scripts/rebuild-flycast.sh
+++ b/scripts/rebuild-flycast.sh
@@ -1,11 +1,31 @@
 #!/usr/bin/env bash
-# Configure + build with logs (~/resonance-build/logs/{configure,build}.log) and an error summary.
-#   rebuild-flycast.sh [clean]
-set -uo pipefail
+# Fail-closed replacement for ReSONANCE scripts/rebuild-flycast.sh.
+set -euo pipefail
 HERE="$(cd "$(dirname "$0")" && pwd)"
-[ "${1:-}" = clean ] && rm -rf "$HOME/resonance-build/build/flycast"
-bash "$HERE/logrun.sh" configure bash "$HERE/configure-flycast.sh" || { tail -30 "$HOME/resonance-build/logs/configure.log"; exit 1; }
-bash "$HERE/logrun.sh" build bash "$HERE/build-flycast.sh" -k 0
-L="$HOME/resonance-build/logs/build.log"
-tail -1 "$L"; echo "errors: $(grep -c 'error:' "$L")"
-grep "error:" "$L" | sed 's/.*src\/flycast\///' | sort | uniq -c | sort -rn | head -${TOP:-60}
+BUILD_ROOT="${PS4_BUILD_ROOT:-$HOME/resonance-build}"
+LOG_DIR="$BUILD_ROOT/logs"
+mkdir -p "$LOG_DIR"
+if [[ "${1:-}" == clean ]]; then
+  rm -rf "$BUILD_ROOT/build/flycast"
+fi
+if ! bash "$HERE/logrun.sh" configure bash "$HERE/configure-flycast.sh"; then
+  tail -n 30 "$LOG_DIR/configure.log" >&2 || true
+  echo 'ERROR: configure failed; build and packaging aborted' >&2
+  exit 20
+fi
+if bash "$HERE/logrun.sh" build bash "$HERE/build-flycast.sh" -k 0; then
+  rc=0
+else
+  rc=$?
+fi
+L="$LOG_DIR/build.log"
+tail -n 1 "$L" || true
+echo "compiler error lines: $(grep -c 'error:' "$L" || true)"
+(grep 'error:' "$L" || true) | sed 's/.*src\/flycast\///' | sort | uniq -c | sort -rn | head -n "${TOP:-60}" || true
+if (( rc != 0 )); then
+  echo "ERROR: PS4 build failed with exit=$rc; packaging aborted" >&2
+  exit "$rc"
+fi
+EBOOT="$BUILD_ROOT/build/flycast/shell/ps4/flycast_eboot/eboot.bin"
+[[ -s "$EBOOT" ]] || { echo "ERROR: build exited 0 but missing eboot.bin: $EBOOT" >&2; exit 21; }
+echo "PS4 build completed: $EBOOT"
